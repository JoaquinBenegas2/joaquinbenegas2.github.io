---
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title: string;
  description?: string;
}

interface NavItem {
  href: string;
  label: string;
  isActive?: boolean;
  isExternal?: boolean;
}

const { title, description } = Astro.props as Props;
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
const normalizedPathname =
  pathname !== "/" && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;

function isNavActive(path: string): boolean {
  return normalizedPathname === path || normalizedPathname.startsWith(`${path}/`);
}

const isArticlesActive = isNavActive("/articles");
const isBlogActive = isNavActive("/blog");
const navItems: NavItem[] = [
  {
    href: "/articles",
    label: "Articles",
    isActive: isArticlesActive,
  },
  {
    href: "/blog",
    label: "Blog",
    isActive: isBlogActive,
  },
  {
    href: "https://github.com/JoaquinBenegas2",
    label: "GitHub",
    isExternal: true,
  },
];
---

<!doctype html>
<html lang="en">
  <BaseHead {title} {description} />
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="nav-brand">Joaquin Benegas</a>
        <div class="nav-actions">
          <ul class="nav-links">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={{ "is-active": item.isActive }}
                    aria-current={item.isActive ? "page" : undefined}
                    target={item.isExternal ? "_blank" : undefined}
                    rel={item.isExternal ? "noreferrer" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
            <span class="theme-icon theme-icon-sun">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <line x1="12" y1="2" x2="12" y2="5"/>
                <line x1="12" y1="19" x2="12" y2="22"/>
                <line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/>
                <line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/>
                <line x1="2" y1="12" x2="5" y2="12"/>
                <line x1="19" y1="12" x2="22" y2="12"/>
                <line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/>
                <line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/>
              </svg>
            </span>
            <span class="theme-icon theme-icon-moon">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </span>
          </button>
          <button
            class="nav-menu-toggle"
            id="nav-menu-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-controls="mobile-nav-links"
            aria-expanded="false"
          >
            <span class="nav-menu-toggle__line"></span>
            <span class="nav-menu-toggle__line"></span>
          </button>
        </div>
      </nav>
    </header>
    <ul class="mobile-nav-links" id="mobile-nav-links">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={{ "is-active": item.isActive }}
              aria-current={item.isActive ? "page" : undefined}
              target={item.isExternal ? "_blank" : undefined}
              rel={item.isExternal ? "noreferrer" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <main class="page-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {currentYear} Joaquin Benegas</p>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const themeToggle = document.getElementById("theme-toggle");
      const navMenuToggle = document.getElementById("nav-menu-toggle");
      const mobileNavLinks = document.getElementById("mobile-nav-links");
      const openNavLabel = "Open navigation menu";
      const closeNavLabel = "Close navigation menu";

      function getNextTheme(currentTheme) {
        return currentTheme === "dark" ? "light" : "dark";
      }

      function toggleTheme() {
        const nextTheme = getNextTheme(root.getAttribute("data-theme"));

        root.setAttribute("data-theme", nextTheme);
        localStorage.setItem("theme", nextTheme);
      }

      themeToggle?.addEventListener("click", toggleTheme);

      function setNavMenuOpen(isOpen) {
        if (!navMenuToggle || !mobileNavLinks) {
          return;
        }

        navMenuToggle.setAttribute("aria-expanded", String(isOpen));
        navMenuToggle.setAttribute("aria-label", isOpen ? closeNavLabel : openNavLabel);
        mobileNavLinks.classList.toggle("is-open", isOpen);
      }

      navMenuToggle?.addEventListener("click", function () {
        const isOpen = navMenuToggle.getAttribute("aria-expanded") === "true";

        setNavMenuOpen(!isOpen);
      });

      mobileNavLinks?.addEventListener("click", function (event) {
        if (!(event.target instanceof Element) || !event.target.closest("a")) {
          return;
        }

        setNavMenuOpen(false);
      });

      document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape") {
          return;
        }

        setNavMenuOpen(false);
      });
    </script>
    <script>
      import mermaid from "mermaid";

      const THEME_ATTRIBUTE = "data-theme";
      const DIAGRAM_CLASS = "mermaid-diagram";
      const DIAGRAM_CANVAS_SELECTOR = ".mermaid-diagram__canvas";
      const DIAGRAM_SELECTOR = ".prose pre > code.language-mermaid";
      let isWatchingThemeChanges = false;

      function getMermaidTheme(): "dark" | "default" {
        return document.documentElement.getAttribute(THEME_ATTRIBUTE) === "dark" ? "dark" : "default";
      }

      function isHTMLElement(value: Element | null): value is HTMLElement {
        return value instanceof HTMLElement;
      }

      function getDiagramCanvas(diagram: HTMLElement): HTMLDivElement | null {
        const canvas = diagram.querySelector(DIAGRAM_CANVAS_SELECTOR);

        return canvas instanceof HTMLDivElement ? canvas : null;
      }

      function getDiagramWrappers(): HTMLElement[] {
        return Array.from(document.querySelectorAll(`.${DIAGRAM_CLASS}`)).filter(isHTMLElement);
      }

      function upgradeMermaidBlocks() {
        for (const code of document.querySelectorAll(DIAGRAM_SELECTOR)) {
          const pre = code.parentElement;
          const source = code.textContent?.trim();

          if (!(pre instanceof HTMLPreElement) || !source) {
            continue;
          }

          const wrapper = document.createElement("figure");
          const canvas = document.createElement("div");

          wrapper.className = DIAGRAM_CLASS;
          wrapper.dataset.mermaidSource = source;
          canvas.className = "mermaid-diagram__canvas";
          wrapper.append(canvas);

          pre.replaceWith(wrapper);
        }
      }

      async function renderMermaidDiagrams() {
        upgradeMermaidBlocks();

        const diagrams = getDiagramWrappers();

        if (diagrams.length === 0) {
          return;
        }

        mermaid.initialize({
          startOnLoad: false,
          theme: getMermaidTheme(),
        });

        for (const [index, diagram] of diagrams.entries()) {
          const source = diagram.dataset.mermaidSource;
          const canvas = getDiagramCanvas(diagram);

          if (!canvas || !source) {
            continue;
          }

          const { svg, bindFunctions } = await mermaid.render(`mermaid-diagram-${index}`, source);

          canvas.innerHTML = svg;
          bindFunctions?.(canvas);
        }
      }

      function watchThemeChanges() {
        if (isWatchingThemeChanges) {
          return;
        }

        isWatchingThemeChanges = true;

        const observer = new MutationObserver((mutations) => {
          const hasThemeChange = mutations.some((mutation) => {
            return mutation.type === "attributes" && mutation.attributeName === THEME_ATTRIBUTE;
          });

          if (hasThemeChange) {
            void renderMermaidDiagrams();
          }
        });

        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: [THEME_ATTRIBUTE],
        });
      }

      function initMermaid() {
        watchThemeChanges();
        void renderMermaidDiagrams();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMermaid, { once: true });
      } else {
        initMermaid();
      }
    </script>
  </body>
</html>
