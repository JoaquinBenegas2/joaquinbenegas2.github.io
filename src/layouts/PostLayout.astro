---
import BaseLayout from "./BaseLayout.astro";
import { formatLongDate } from "../utils/posts";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  date,
  tags,
  backHref = "/articles",
  backLabel = "Articles",
} = Astro.props as Props;

const formattedDate = date ? formatLongDate(date) : undefined;
const hasTags = Boolean(tags && tags.length > 0);
---

<BaseLayout {title} {description}>
  <div class="post-container">
    <a href={backHref} class="post-back">← {backLabel}</a>

    <header class="post-header">
      {hasTags && <div class="post-tags">{tags?.map((tag) => <span class="tag">{tag}</span>)}</div>}
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-description">{description}</p>}
      {formattedDate && <p class="post-meta">{formattedDate}</p>}
    </header>

    <hr class="post-divider" />

    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
