---
import BaseLayout from "../layouts/BaseLayout.astro";

const HOME_DESCRIPTION =
  "Posts about what I am learning on my journey as a developer, from ideas and experiments to practical lessons.";
---

<BaseLayout
  title="Joaquin Benegas"
  description={HOME_DESCRIPTION}
>
  <div class="page-header page-header--home">
    <h1>Joaquin Benegas</h1>
    <p>{HOME_DESCRIPTION}</p>
  </div>

  <div class="home-sections">
    <p class="home-sections-label">Explore</p>
    <ul class="home-nav-list">
      <li><a href="/about">About me</a></li>
      <li><a href="/articles">Articles</a></li>
      <li><a href="/blog">Blog</a></li>
    </ul>
  </div>
</BaseLayout>
